# BTC Transaction Tracker - environment template.
# Every source uses a public, keyless API: exchange fetchers read public
# market-data endpoints for BTC buy/sell trades. Copy this file to `.env`
# only to override the application defaults below.

# --- Application ---
DATABASE_PATH=btc_tracker.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# --- Rate limiting ---
DEFAULT_RATE_LIMIT_REQUESTS=10
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=1.0
