# BTC Transaction Tracker - environment template.
# Every source uses a public, keyless API: exchange fetchers read public
# market-data endpoints for BTC buy/sell trades. Copy this file to `.env`
# only to override the application defaults below.

# --- Application ---
DATABASE_PATH=btc_tracker.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# --- Rate limiting ---
DEFAULT_RATE_LIMIT_REQUESTS=10
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=1.0

# --- Live feed ---
# Seconds between live polls of each source.
POLL_INTERVAL_SECONDS=5.0
# Pages fetched per source on the first pass (backfill) and on later polls.
BACKFILL_PAGES=3
POLL_PAGES=1
# Stored rows hydrated at startup and maximum rows kept in the live store.
HISTORY_LIMIT=50000
MAX_TRANSACTIONS=50000

# --- UI ---
# Maximum table rows rendered; all loaded trades still count toward totals.
RENDER_LIMIT=1000
# Minimum seconds between UI data flushes and search-input debounce.
UI_FLUSH_INTERVAL_SECONDS=0.25
SEARCH_DEBOUNCE_SECONDS=0.15
